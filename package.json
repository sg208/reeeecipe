{
  "name": "nuxt4-nuxti18n",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "fix": "pnpm lint:fix && pnpm format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,vue,json,css,md}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:component": "vitest run tests/components",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "build": "nuxt generate",
    "deploy": "pnpm generate && wrangler deploy"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.1.0",
    "@nuxtjs/i18n": "^10.2.0",
    "@tanstack/vue-query": "^5.59.0",
    "@tanstack/vue-query-devtools": "^6.3.6",
    "nuxt": "^4.2.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/icon": "^2.1.0",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "vue-demi",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "fontless>esbuild": "^0.28.1"
    }
  }
}
