{
  "name": "nuxt4-nuxti18n",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "fix": "npm run lint:fix && npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,vue,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:component": "vitest run tests/components",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.1.0",
    "@nuxtjs/i18n": "^10.2.0",
    "@tanstack/vue-query": "^5.59.0",
    "@tanstack/vue-query-devtools": "^5.59.0",
    "@vueuse/core": "^14.0.0",
    "nuxt": "^4.2.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/icon": "^2.1.0",
    "@nuxt/test-utils": "^3.20.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "happy-dom": "^20.0.10",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.3"
  },
  "optionalDependencies": {
    "sharp": "^0.34.4"
  }
}
